msgstr "Η παραγγελία σας έχει αποσταλεί!"

msgid "Your Receipt"
msgstr "Η Απόδειξή σου"

msgid "Your account is being deleted. You will be logged out shortly. Orders are retained in anonymised form for tax/accounting purposes."
msgstr "Ο λογαριασμός σας διαγράφεται. Θα αποσυνδεθείτε σύντομα. Οι παραγγελίες διατηρούνται σε ανωνυμοποιημένη μορφή για φορολογικούς/λογιστικούς λόγους."

msgid "Your account is still active and all your data is exactly where you left it. We've been keeping everything safe and ready for your return!"
msgstr "Ο λογαριασμός σας παραμένει ενεργός και όλα τα δεδομένα σας βρίσκονται ακριβώς εκεί που τα αφήσατε. Τα κρατάμε ασφαλή και έτοιμα για την επιστροφή σας!"

msgid "Your business account has been approved"
msgstr "Ο εταιρικός σας λογαριασμός εγκρίθηκε"

msgid "Your business's legal details are missing"
msgstr "Λείπουν νομικά στοιχεία της επιχείρησής σας"

msgid "Your data and preferences are still safely stored"
msgstr "Τα δεδομένα και οι προτιμήσεις σας διατηρούνται με ασφάλεια"

