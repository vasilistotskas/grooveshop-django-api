#: .\cart\views\item.py:95
msgid "Partially update a cart item"
msgstr "Μερική ενημέρωση είδους καλαθιού"

#: .\cart\views\item.py:97
msgid ""
"Partially update cart item information. Requires authentication. For guest "
"users, include X-Cart-Id header to maintain cart session."
msgstr ""
"Μερική ενημέρωση πληροφοριών είδους καλαθιού. Απαιτεί ταυτοποίηση. Για "
"επισκέπτες, συμπεριλάβετε την κεφαλίδα X-Cart-Id για διατήρηση της συνεδρίας"
" καλαθιού."

#: .\cart\views\item.py:104
msgid "Delete a cart item"
msgstr "Διαγραφή αντικειμένου καλαθιού"

