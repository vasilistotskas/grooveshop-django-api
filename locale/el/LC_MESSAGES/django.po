msgstr "Πρέπει να έχετε αγοράσει το προϊόν για να το αξιολογήσετε."

msgid "You received a gift card!"
msgstr "Λάβατε μια δωροκάρτα!"

msgid "You will receive a second email as soon as we confirm your payment."
msgstr "Θα λάβετε ένα δεύτερο email μόλις επιβεβαιώσουμε την πληρωμή σας."

#, python-format
msgid "You're receiving this email because %(user_display)s added your email address to their account on %(SITE_NAME)s."
msgstr "Λαμβάνετε αυτό το email επειδή ο χρήστης %(user_display)s πρόσθεσε τη διεύθυνση email σας στον λογαριασμό του στο %(SITE_NAME)s."

#, python-format
msgid "You're receiving this email because user %(user_display)s has given your email address to register an account on %(site_name)s."
msgstr "Λαμβάνετε αυτό το email επειδή ο χρήστης %(user_display)s έδωσε τη διεύθυνση email σας για να δημιουργήσει λογαριασμό στο %(site_name)s."

msgid "You're receiving this email because you or someone else has requested a password reset for your account. It can be safely ignored if you did not request a password reset."
msgstr "Λαμβάνετε αυτό το email επειδή εσείς ή κάποιος άλλος ζήτησε επαναφορά του κωδικού πρόσβασης του λογαριασμού σας. Μπορείτε να το αγνοήσετε με ασφάλεια αν δεν ζητήσατε επαναφορά κωδικού πρόσβασης."

msgid "YouTube URL"
msgstr "URL YouTube"

msgid "YouTube channel URL. Must use https://. Empty → link hidden in storefront footer."
msgstr "URL καναλιού YouTube. Πρέπει να χρησιμοποιεί https://. Κενό → ο σύνδεσμος κρύβεται στο footer του storefront."

#, python-format
msgid "Your %(plan)s plan term ended on %(date)s. Your store is still running, but not for long."
msgstr "Η περίοδος του πλάνου %(plan)s έληξε στις %(date)s. Το κατάστημά σας λειτουργεί ακόμη, αλλά όχι για πολύ."

#, python-format
msgid "Your %(plan)s plan term ends on %(date)s (inclusive). To keep your store running without interruption, arrange the renewal before then."
msgstr "Η περίοδος του πλάνου %(plan)s λήγει στις %(date)s (συμπεριλαμβανομένης). Για να συνεχίσει το κατάστημά σας χωρίς διακοπή, κανονίστε την ανανέωση πριν από τότε."

msgid "Your ACS parcel is out for delivery"
msgstr "Το δέμα σας ACS βρίσκεται σε διανομή"

msgid "Your BOX NOW parcel arrived"
msgstr "Το πακέτο BOX NOW έφτασε"

