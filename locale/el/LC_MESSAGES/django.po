msgid "WE MISS YOU! - %(site_name)s"
msgstr "ΜΑΣ ΛΕΙΠΕΤΕ! - %(site_name)s"

msgid "WHAT YOU'LL RECEIVE"
msgstr "ΤΙ ΘΑ ΛΑΒΕΤΕ"

msgid "Waiting for approval"
msgstr "Σε αναμονή έγκρισης"

msgid "Waiting for wholesale prices"
msgstr "Περιμένουν τιμές χονδρικής"

msgid "Wall-clock time when the polling task observed this event."
msgstr "Πραγματικός χρόνος κατά τον οποίο η εργασία παρακολούθησης παρατήρησε αυτό το συμβάν."

msgid "Warehouse"
msgstr "Αποθήκη (warehouse)"

msgid "Warning"
msgstr "Προειδοποίηση"

