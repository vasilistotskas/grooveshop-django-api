#: .\order\views\item.py:45
msgid "Process a refund for an order item"
msgstr "Επεξεργασία επιστροφής χρημάτων για είδος παραγγελίας"

#: .\order\views\item.py:46
msgid "Process a refund for an order item."
msgstr "Επεξεργασία επιστροφής χρημάτων για είδος παραγγελίας."

#: .\order\views\item.py:118 .\order\views\order.py:501
#: .\order\views\order.py:507
