msgstr "Η ΑΠΟΔΕΙΞΗ ΣΟΥ"

msgid "Year"
msgstr "Έτος"

msgid "Yes"
msgstr "Ναι"

msgid "Yes, permanently destroy"
msgstr "Ναι, οριστική διαγραφή"

msgid "Yes: the goods came back or were never delivered, so the sale is reversed and the receipt is credited. No: the customer kept the goods and the sale stands."
msgstr "Ναι: τα προϊόντα επέστρεψαν ή δεν παραδόθηκαν, άρα η πώληση αντιστρέφεται και η απόδειξη πιστώνεται. Όχι: ο πελάτης κράτησε τα προϊόντα και η πώληση ισχύει."

msgid "You already have an active alert of this kind for this product."
msgstr "Έχετε ήδη ενεργή ειδοποίηση αυτού του τύπου για αυτό το προϊόν."

#, python-brace-format
msgid "You already have {count} orders waiting for their payment. Pay for or cancel one before placing another."
msgstr "Έχετε ήδη {count} παραγγελίες που περιμένουν πληρωμή. Πληρώστε ή ακυρώστε μία πριν κάνετε άλλη."

msgid "You are already subscribed to this topic."
msgstr "Είστε ήδη εγγεγραμμένος/η σε αυτό το θέμα."

#, python-format
msgid "You are authenticated as %(username)s, but are not authorized to access this page. Would you like to login to a different account?"
msgstr "Έχετε ταυτοποιηθεί ως %(username)s, αλλά δεν έχετε εξουσιοδότηση για πρόσβαση σε αυτή τη σελίδα. Θέλετε να συνδεθείτε με διαφορετικό λογαριασμό;"

msgid "You are not subscribed to this topic."
msgstr "Δεν είστε εγγεγραμμένος/η σε αυτό το θέμα."

msgid "You are receiving this email because the following change was made to your account:"
msgstr "Λαμβάνετε αυτό το email επειδή έγινε η ακόλουθη αλλαγή στον λογαριασμό σας:"

#, python-format
msgid "You are receiving this email because you, or someone else, tried to access an account with email %(email)s. However, we do not have any record of such an account."
msgstr "Λαμβάνετε αυτό το email επειδή εσείς ή κάποιος άλλος προσπάθησε να αποκτήσει πρόσβαση σε λογαριασμό με email %(email)s. Ωστόσο, δεν υπάρχει καμία εγγραφή τέτοιου λογαριασμού."

#, python-format
msgid "You are receiving this email because you, or someone else, tried to sign up for an account using the email address %(email)s. However, an account using that email address already exists."
msgstr "Λαμβάνετε αυτό το email επειδή εσείς ή κάποιος άλλος προσπάθησε να εγγραφεί με τη διεύθυνση email %(email)s. Ωστόσο, υπάρχει ήδη λογαριασμός με αυτή τη διεύθυνση email."

msgid "You can only delete your own account."
msgstr "Μπορείτε να διαγράψετε μόνο τον δικό σας λογαριασμό."

msgid "You can only reorder your own past orders."
msgstr "Μπορείτε να επαναλάβετε μόνο τις δικές σας προηγούμενες παραγγελίες."

msgid "You can track your package using the tracking number above on the carrier's website."
msgstr "Μπορείτε να παρακολουθήσετε το δέμα σας χρησιμοποιώντας τον παραπάνω αριθμό παρακολούθησης στην ιστοσελίδα του μεταφορέα."

msgid "You can update your details from your account page and submit the application again — it will be reviewed anew."
msgstr "Μπορείτε να ενημερώσετε τα στοιχεία σας από τη σελίδα του λογαριασμού σας και να υποβάλετε ξανά την αίτηση — θα εξεταστεί εκ νέου."

msgid "You can view these texts but you do not have permission to change them."
msgstr "Μπορείτε να δείτε αυτά τα κείμενα αλλά δεν έχετε δικαίωμα να τα αλλάξετε."

msgid "You do not have permission to access this cart item."
msgstr "Δεν έχετε δικαίωμα πρόσβασης σε αυτό το είδος καλαθιού."

msgid "You do not have permission to access this cart."
msgstr "Δεν έχετε δικαίωμα πρόσβασης σε αυτό το καλάθι."

msgid "You do not have permission to access this object."
msgstr "Δεν έχετε δικαίωμα πρόσβασης σε αυτό το αντικείμενο."

msgid "You do not have permission to access this order."
msgstr "Δεν έχετε δικαίωμα πρόσβασης σε αυτή την παραγγελία."

msgid "You do not have permission to cancel this order"
msgstr "Δεν έχετε δικαίωμα ακύρωσης αυτής της παραγγελίας"

msgid "You do not have permission to delete this cart item."
msgstr "Δεν έχετε δικαίωμα διαγραφής αυτού του είδους καλαθιού."

msgid "You do not have permission to manage this resource."
msgstr "Δεν έχετε δικαίωμα διαχείρισης αυτού του πόρου."

msgid "You do not have permission to perform this action."
msgstr "Δεν έχετε δικαίωμα εκτέλεσης αυτής της ενέργειας."

msgid "You have already reviewed this product."
msgstr "Έχετε ήδη αξιολογήσει αυτό το προϊόν."

msgid "You left something behind"
msgstr "Ξεχάσατε κάτι στο καλάθι σας"

