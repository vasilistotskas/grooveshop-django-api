msgstr "Η εξαγωγή δεδομένων σας είναι έτοιμη — %(site_name)s"

#, python-format
msgid "Your email has been changed from %(from_email)s to %(to_email)s."
msgstr "Το email σας άλλαξε από %(from_email)s σε %(to_email)s."

msgid "Your email verification code is listed below. Please enter it in your open browser window."
msgstr "Ο κωδικός επαλήθευσης του email σας εμφανίζεται παρακάτω. Εισαγάγετέ τον στο ανοιχτό παράθυρο του προγράμματος περιήγησης."

msgid "Your gift card"
msgstr "Η δωροκάρτα σας"

msgid "Your gift card code"
msgstr "Ο κωδικός της δωροκάρτας σας"

msgid "Your gift card expires soon"
msgstr "Η δωροκάρτα σας λήγει σύντομα"

msgid "Your legal pages need an update"
msgstr "Οι νομικές σελίδες σας χρειάζονται ενημέρωση"

#, python-format
msgid "Your order #%(order_id)s has been canceled as requested."
msgstr "Η παραγγελία σας #%(order_id)s έχει ακυρωθεί όπως ζητήθηκε."

#, python-format
msgid "Your order #%(order_id)s has been successfully completed."
msgstr "Η παραγγελία σας #%(order_id)s ολοκληρώθηκε επιτυχώς."

#, python-format
msgid "Your order #%(order_id)s has been updated."
msgstr "Η παραγγελία σας #%(order_id)s έχει ενημερωθεί."

msgid "Your order has arrived. We'd love to hear what you think — reviews help other shoppers."
msgstr "Η παραγγελία σου έφτασε. Θα θέλαμε πολύ να ακούσουμε τη γνώμη σου — οι κριτικές βοηθούν και άλλους αγοραστές."

msgid "Your order has been canceled. Any payment taken will be refunded to the original method."
msgstr "Η παραγγελία σου ακυρώθηκε. Οποιαδήποτε χρέωση έγινε θα επιστραφεί στον αρχικό τρόπο πληρωμής."

msgid "Your order has been canceled. If you didn't request this, please contact us."
msgstr "Η παραγγελία σας έχει ακυρωθεί. Αν δεν το ζητήσατε εσείς, παρακαλούμε επικοινωνήστε μαζί μας."

msgid "Your order has been completed successfully. Thank you for shopping with us!"
msgstr "Η παραγγελία σας ολοκληρώθηκε επιτυχώς. Ευχαριστούμε πολύ!"

msgid "Your order has been delivered and completed. We hope you're enjoying your purchase!"
msgstr "Η παραγγελία σας παραδόθηκε και ολοκληρώθηκε. Ελπίζουμε να απολαμβάνετε την αγορά σας!"

msgid "Your order has been delivered to your shipping address."
msgstr "Η παραγγελία σας έχει παραδοθεί στη διεύθυνση αποστολής σας."

msgid "Your order has been received and is awaiting payment processing."
msgstr "Η παραγγελία σας έχει ληφθεί και αναμένει επεξεργασία πληρωμής."

msgid "Your order has been shipped and is on its way to you."
msgstr "Η παραγγελία σας έχει αποσταλεί και είναι καθ' οδόν προς εσάς."

msgid "Your order has shipped. Tracking details will appear in the order page shortly."
msgstr "Η παραγγελία σου εστάλη. Τα στοιχεία παρακολούθησης θα εμφανιστούν σύντομα στη σελίδα της παραγγελίας."

msgid "Your order status has been updated."
msgstr "Η κατάσταση της παραγγελίας σας έχει ενημερωθεί."

msgid "Your own sender address, e.g. orders@your-domain.gr. It takes effect only once the platform ticks From Email Verified, which happens after your domain is authenticated on the mail relay. Until then mail goes out from the platform address with your store name as the display name. Set Contact Email too: that is the reply-to address customers actually reach you on."
msgstr "Η δική σας διεύθυνση αποστολέα, π.χ. orders@your-domain.gr. Ισχύει μόνο αφού η πλατφόρμα επιλέξει το Επαληθευμένο Email Αποστολέα, κάτι που γίνεται αφού πιστοποιηθεί το domain σας στο mail relay. Μέχρι τότε τα μηνύματα αποστέλλονται από τη διεύθυνση της πλατφόρμας με το όνομα του καταστήματός σας ως εμφανιζόμενο όνομα. Ορίστε και το Email Επικοινωνίας: αυτή είναι η διεύθυνση απάντησης (reply-to) στην οποία σας βρίσκουν πραγματικά οι πελάτες."

#, python-format
msgid "Your parcel for order #%(order_id)s has arrived at the BOX NOW locker and is ready for pickup."
msgstr "Το δέμα σας για την παραγγελία #%(order_id)s έφτασε στο locker BOX NOW και είναι έτοιμο για παραλαβή."

msgid "Your parcel is already with the courier, so the order can no longer be canceled. Contact the store to arrange a return."
msgstr "Το δέμα σας βρίσκεται ήδη στον courier, επομένως η παραγγελία δεν μπορεί πλέον να ακυρωθεί. Επικοινωνήστε με το κατάστημα για να κανονίσετε επιστροφή."

msgid "Your parcel is available for pickup 24 hours a day, 7 days a week."
msgstr "Το δέμα σας είναι διαθέσιμο για παραλαβή 24 ώρες το 24ωρο, 7 ημέρες την εβδομάδα."

msgid "Your password has been changed."
msgstr "Ο κωδικός πρόσβασής σας άλλαξε."

msgid "Your password has been reset."
msgstr "Έγινε επαναφορά του κωδικού πρόσβασής σας."

msgid "Your password has been set."
