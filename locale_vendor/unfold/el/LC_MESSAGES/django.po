msgstr "Νέο"

msgid "Skipped"
msgstr "Παραλείφθηκε"

msgid "Update"
msgstr "Ενημέρωση"

msgid "Some rows failed to validate"
msgstr "Ορισμένες γραμμές δεν πέρασαν τον έλεγχο"

msgid ""
"Please correct these errors in your data where possible, then reupload it "
"using the form above."
msgstr ""
"Διορθώστε αυτά τα σφάλματα στα δεδομένα σας όπου είναι δυνατό και ανεβάστε "
"τα ξανά με την παραπάνω φόρμα."

msgid "Row"
msgstr "Γραμμή"

msgid "Non field specific"
msgstr "Χωρίς συγκεκριμένο πεδίο"

msgid "This exporter will export the following fields: "
msgstr "Η εξαγωγή θα περιλάβει τα παρακάτω πεδία: "

